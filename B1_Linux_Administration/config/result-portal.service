[Unit]
Description=University Result Portal Flask Service
After=network.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/result-portal
Environment="PATH=/opt/result-portal/.venv/bin"
ExecStart=/opt/result-portal/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
